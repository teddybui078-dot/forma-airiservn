rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Reference ghost clips are readable by any signed-in athlete.
    match /referenceGhosts/{exercise} {
      allow read: if request.auth != null;
      allow write: if false; // seeded server-side only
    }

    // Session logs belong to the athlete that created them.
    match /sessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.athleteId;
    }
  }
}
